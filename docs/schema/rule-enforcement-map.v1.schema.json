{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotnet-modulith-baseline.local/schemas/rule-enforcement-map.v1.schema.json",
  "title": "Rule Enforcement Map v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "rules": {
      "type": "object",
      "propertyNames": {
        "pattern": "^BP-[0-9]{3}$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true
      }
    }
  }
}
