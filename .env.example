# Docker Compose environment variables
# Copy this file to .env and fill in values before running docker-compose.
# .env is gitignored and must not be committed.

# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Seeded identity credentials (Development/Testing only)
# These are rejected outside Development and Testing environments.
SEEDED_ADMIN_PASSWORD=LocalOnly!123
SEEDED_MACHINE_API_KEY=MachineOnly!123
